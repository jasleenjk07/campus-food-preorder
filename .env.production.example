# Copy to .env.production on the VPS and fill in real values:
#   cp .env.production.example .env.production

POSTGRES_USER=cravix
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=campus_food

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LOG_LEVEL=INFO

# Public HTTPS URL of your API (no trailing slash)
# Examples:
#   https://api.yourdomain.com
#   https://YOUR_VPS_IP   (temporary; prefer a domain + SSL)
PUBLIC_BASE_URL=https://api.yourdomain.com

# Comma-separated browser origins, or * for any (Android native apps ignore CORS)
CORS_ORIGINS=*

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Cravix <noreply@cravix.com>
